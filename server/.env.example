# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Comma-separated exact origins. Keep local origins explicit.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Required only by the migration command; use a local development database.
DATABASE_URL=postgres://ikigai:change-me@localhost:5432/ikigai_dev
