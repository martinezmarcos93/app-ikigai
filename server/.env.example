# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Keep 0 unless the app is behind a known reverse proxy; then set the exact trusted hop count (1-5).
TRUST_PROXY_HOPS=0
SESSION_SECRET=development-only-session-secret-change-before-deploy
# In production, use a random secret of at least 32 characters from the secret manager.
# Comma-separated exact origins. Keep local origins explicit.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Required only by the migration command; use a local development database.
DATABASE_URL=postgres://ikigai:change-me@localhost:5432/ikigai_dev

# Production password-reset delivery webhook. The endpoint receives a JSON
# payload is either a real reset event (with resetUrl/expiresAt) or a no-op event
# for unknown accounts. It must enqueue promptly and send only the real reset event.
# Keep the token in the deployment secret manager; never commit real values.
# Production requires HTTPS URLs, a token of at least 32 characters, and the
# public reset URL's origin must be listed in CORS_ORIGINS.
# PASSWORD_RESET_DELIVERY_URL=https://your-mail-adapter.example/send
# PASSWORD_RESET_DELIVERY_TOKEN=replace-with-a-random-secret-of-at-least-32-chars
# PASSWORD_RESET_PUBLIC_URL=https://gym.example.com/reset-password
