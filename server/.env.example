# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SESSION_SECRET=development-only-session-secret-change-before-deploy
# In production, use a random secret of at least 32 characters from the secret manager.
# Comma-separated exact origins. Keep local origins explicit.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Required only by the migration command; use a local development database.
DATABASE_URL=postgres://ikigai:change-me@localhost:5432/ikigai_dev
# Password reset delivery (required in production)
# Use a verified sender/domain in Resend.
RESEND_API_KEY=
PASSWORD_RESET_FROM="Ikigai Training <seguridad@tu-dominio.example>"
# Public HTTPS URL of reset-password.html; the API appends the token as a URL fragment, never a query parameter.
PASSWORD_RESET_BASE_URL=https://tu-dominio.example/reset-password
