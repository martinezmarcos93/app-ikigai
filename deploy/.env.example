# Copiar a deploy/.env (NO se versiona) y completar. Los secretos se generan, no se inventan:
#   openssl rand -hex 24   # POSTGRES_PASSWORD (solo caracteres seguros para una URL)
#   openssl rand -hex 32   # SESSION_SECRET y PASSWORD_RESET_DELIVERY_TOKEN

NODE_ENV=production
POSTGRES_PASSWORD=
SESSION_SECRET=

# Origen publico del portal, exacto, sin barra final. Tambien lo usa la API como CORS.
PUBLIC_ORIGIN=https://ikigai.ejemplo.com
# Dominio (HTTPS automatico) o http://localhost para una prueba local.
SITE_ADDRESS=ikigai.ejemplo.com
HTTP_PORT=80
HTTPS_PORT=443

GYM_TIMEZONE=America/Argentina/Buenos_Aires

# Obligatorios en produccion: adaptador HTTPS que entrega el enlace de recuperacion de contrasena.
PASSWORD_RESET_DELIVERY_URL=https://mail-adapter.ejemplo.com/ikigai
PASSWORD_RESET_DELIVERY_TOKEN=
PASSWORD_RESET_PUBLIC_URL=https://ikigai.ejemplo.com/reset-password.html
