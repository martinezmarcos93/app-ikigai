# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:3001
DATABASE_URL=postgres://ikigai:change-me@127.0.0.1:5432/ikigai
DATABASE_SSL=false
SESSION_TTL_HOURS=12
# Required for production startup. Use a long random value (32+ bytes).
SESSION_PEPPER=replace-with-a-long-random-secret